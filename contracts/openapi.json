    "/api/follow-ups": {
      "post": {
        "operationId": "post__api_follow_ups",
        "summary": "A next step (salvation, baptism, new, growth_track, visit) into the staff follow-up queue. Public; rate limited per client.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sign in or step up"
          },
          "403": {
            "description": "Not allowed"
          },
          "400": {
            "description": "Invalid input, or contact details without consent"
          },
          "429": {
            "description": "Too many requests from this client"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "consent"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["salvation", "baptism", "new", "growth_track", "visit"]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "consent": {
                    "type": "boolean",
                    "description": "Required true when email or phone is sent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/care/follow-ups": {
      "get": {
        "operationId": "get__api_care_follow_ups",
        "summary": "Staff follow-up queue. Requires care access and step-up; every read is audited.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sign in or step up"
          },
          "403": {
            "description": "Not allowed"
          }
        }
      }
    },
    "/api/care/follow-ups/{id}": {
      "post": {
        "operationId": "post__api_care_follow_ups_id",
        "summary": "Set a follow-up's status.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sign in or step up"
          },
          "403": {
            "description": "Not allowed"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["new", "contacted", "closed"]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/growth": {
      "get": {
        "operationId": "get__api_growth",
        "summary": "The church's Toolkit, Recovery (Unlocking Freedom) page, and Support/Assistance form choices. Public.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sign in or step up"
          },
          "403": {
            "description": "Not allowed"
          }
        }
      }
    },
    "/api/support": {
      "post": {
        "operationId": "post__api_support",
        "summary": "The church's Support/Assistance Request into the staff follow-up queue. Public; rate limited per client.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sign in or step up"
          },
          "403": {
            "description": "Not allowed"
          },
          "400": {
            "description": "Invalid input, no box checked, or a guest with no email or phone"
          },
          "429": {
            "description": "Too many requests from this client"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["needs", "consent"],
                "properties": {
                  "needs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": ["counseling", "premarital", "hospital", "recovery", "volunteer", "clothing"]
                    }
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "consent": {
                    "type": "boolean",
                    "enum": [true],
                    "description": "The form promises a call back, so consent is required"
                  }
                }
              }
            }
          }
        }
      }
    },
