# Copy to .env on the server. Do not commit a filled copy.
# Empty values keep that integration in demo mode.

ONEHOPE_ENV=demo
# Church-authored salvation and baptism wording stays hidden until a pastor approves it.
CONTENT_SALVATION_BAPTISM_APPROVED=false
FIELD_ENCRYPTION_KEY=
MASTER_ADMIN_PRIMARY_NAME=Nicholas Will
MASTER_ADMIN_PRIMARY_EMAIL=nicholas.will@cinderandcrown.com
MASTER_ADMIN_SECONDARY_NAME=Lead Pastor
MASTER_ADMIN_SECONDARY_EMAIL=

# Giving stays dark until all three are set. Apple Pay nonprofit approval is pending.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
GIVING_LIVE=false
APPLE_PAY_NONPROFIT_APPROVED=false

PLANNING_CENTER_CLIENT_ID=
PLANNING_CENTER_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=UCq2WteT5jNlWmXNofRMvQfw
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=com.cinderandcrown.onehope
API_BIBLE_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
POSTHOG_KEY=
GOOGLE_MAPS_API_KEY=

# Public https image URLs for this tenant. Leave empty to use the brand-colored fallback.
# Do not commit the church's photo files or these URLs.
ONEHOPE_IMAGE_HERO=
ONEHOPE_IMAGE_ABOUT=
ONEHOPE_IMAGE_VIDEO=
ONEHOPE_IMAGE_REVIVAL=
ONEHOPE_IMAGE_OG=

# Database driver. Neon hosts use the Neon serverless driver; any other host (Supabase) uses node-postgres.
# DATABASE_DRIVER=pg or neon overrides the guess. DATABASE_CA_CERT is the host's root CA in PEM (Supabase).
DATABASE_DRIVER=
DATABASE_CA_CERT=

# Sign-in provider. Leave unset for this app's own passwords. "clerk" uses Clerk Organizations (one org = one tenant).
AUTH_PROVIDER=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_STEP_UP_MINUTES=
